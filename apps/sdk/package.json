{
  "name": "@validpost/validpost-sdk",
  "version": "2.0.0",
  "description": "Official Node SDK for ValidPost — schedule posts, manage channels, and drive the public API.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "release": "tsup && pnpm publish --access public",
    "release:dry": "tsup && pnpm publish --access public --dry-run --no-git-checks"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "social media",
    "scheduling tool",
    "social media scheduling tool",
    "validpost",
    "social media scheduling",
    "sdk"
  ],
  "author": "Stratnovo",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pogutu-pro/validpost.git"
  },
  "homepage": "https://validpost.io",
  "bugs": {
    "url": "https://github.com/pogutu-pro/validpost/issues"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.1",
    "typescript": "5.5.4",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  }
}
